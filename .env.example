# Database. Leave unset for local development: an embedded Postgres (PGlite) is created in ./.data/pglite.
# In production, point this at a managed Postgres 15+ and run `npm run db:migrate` before `npm start`.
# DATABASE_URL=postgres://arroven:arroven@localhost:5432/arroven

# Where original source files are kept (read-only after import). Use durable storage in production.
STORAGE_DIR=./storage

# ARROVEN's own models, served by ARROVEN's model service (docs/model-service-contract.md). No third-party AI
# service is used. Without MODEL_SERVICE_URL the app uses a clearly labelled offline mock.
# MODEL_SERVICE_URL=https://models.internal.example
# MODEL_SERVICE_TOKEN=
# MODEL_SERVICE_NAME=arroven-model
# MODEL_SERVICE_ALLOW_HTTP=false   # true only for a service on a private network

# Public base URL, used to build invite links.
APP_URL=http://localhost:3000
